<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Ejercicio2Activity">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <!-- Button crea un botón que utilizaremos para comprobar
             y abrir la URL introducida.

             android:id: identifica el botón para utilizarlo desde Kotlin.
             layout_width="match_parent": ocupa todo el ancho disponible.
             layout_height="wrap_content": ocupa solo la altura necesaria.
             android:text: indica el texto que aparece en el botón.
        -->
        <Button
            android:id="@+id/botonAct2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abrir URL" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>