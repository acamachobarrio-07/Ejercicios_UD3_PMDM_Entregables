<?xml version="1.0" encoding="utf-8"?>

<!-- LinearLayout es el contenedor principal de la pantalla.
     Coloca los elementos uno debajo de otro.

     layout_width="match_parent": ocupa todo el ancho disponible.
     layout_height="match_parent": ocupa todo el alto disponible.
     orientation="vertical": coloca los elementos uno debajo de otro.
     gravity="center": centra los elementos dentro del contenedor.
     padding="20dp": deja un espacio interior de 20dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp">

    <!-- EditText permite introducir texto.
         En este caso el usuario escribe una URL.

         android:id: identifica el campo para utilizarlo desde Kotlin.
         layout_width="match_parent": ocupa todo el ancho disponible.
         layout_height="wrap_content": ocupa solo la altura necesaria.
         android:hint: muestra un texto de ayuda cuando está vacío.
         inputType="textUri": adapta el teclado para escribir URLs.
    -->
    <EditText
        android:id="@+id/editUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Introduce una URL"
        android:inputType="textUri" />

    <!-- Button crea un botón que utilizaremos para comprobar
         y abrir la URL introducida.

         android:id: identifica el botón para utilizarlo desde Kotlin.
         layout_width="match_parent": ocupa todo el ancho disponible.
         layout_height="wrap_content": ocupa solo la altura necesaria.
         android:text: indica el texto que aparece en el botón.
    -->
    <Button
        android:id="@+id/botonAbrir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Abrir URL" />

</LinearLayout>
